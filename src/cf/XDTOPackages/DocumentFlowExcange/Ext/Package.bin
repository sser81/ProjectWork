<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://www.sample-package.org">
	<import namespace="http://v8.1c.ru/8.1/data/core"/>
	<objectType name="BalanceOfLimitsForEmployeesList">
		<property xmlns:d3p1="http://www.sample-package.org" name="Row" type="d3p1:BalanceOfLimitsForEmployeesRow" lowerBound="0" upperBound="-1"/>
	</objectType>
	<objectType name="BalanceOfLimitsForEmployeesRow">
		<property xmlns:d3p1="http://www.sample-package.org" name="Stage" type="d3p1:Object" nillable="true"/>
		<property name="Limit" type="xs:decimal" nillable="true"/>
		<property name="Expense" type="xs:decimal" nillable="true"/>
	</objectType>
	<objectType name="LimitsForCashFlowList">
		<property xmlns:d3p1="http://www.sample-package.org" name="Row" type="d3p1:LimitsForCashFlowRow" lowerBound="0" upperBound="-1"/>
	</objectType>
	<objectType name="LimitsForCashFlowRow">
		<property xmlns:d3p1="http://www.sample-package.org" name="Entity" type="d3p1:Object"/>
		<property xmlns:d3p1="http://www.sample-package.org" name="Department" type="d3p1:Object"/>
		<property xmlns:d3p1="http://www.sample-package.org" name="CashFlowItem" type="d3p1:Object"/>
		<property xmlns:d3p1="http://www.sample-package.org" name="Currency" type="d3p1:Object"/>
		<property name="Limit" type="xs:decimal" nillable="true"/>
		<property name="Expense" type="xs:decimal" nillable="true"/>
	</objectType>
	<objectType name="LimitsForEmployeesList">
		<property xmlns:d3p1="http://www.sample-package.org" name="Row" type="d3p1:LimitsForEmployeesRow" lowerBound="0" upperBound="-1"/>
	</objectType>
	<objectType name="LimitsForEmployeesRow">
		<property xmlns:d3p1="http://www.sample-package.org" name="Employee" type="d3p1:Object"/>
		<property xmlns:d3p1="http://www.sample-package.org" name="CashFlowItem" type="d3p1:Object"/>
		<property name="ContractStartDate" type="xs:date" nillable="true"/>
		<property name="Limit" type="xs:decimal" nillable="true"/>
		<property name="Expense" type="xs:decimal" nillable="true"/>
		<property xmlns:d3p1="http://www.sample-package.org" name="Balances" type="d3p1:BalanceOfLimitsForEmployeesList" nillable="true"/>
		<property name="OneTime" type="xs:boolean"/>
		<property name="Resource" type="xs:string" nillable="true" default="amount"/>
	</objectType>
	<objectType xmlns:d2p1="http://www.sample-package.org" name="Object" base="d2p1:ObjectRef">
		<property name="TypeName" type="xs:string" default="" form="Attribute"/>
	</objectType>
	<objectType xmlns:d2p1="http://www.sample-package.org" name="ObjectPredefined" base="d2p1:ObjectPredefinedRef">
		<property name="TypeName" type="xs:string" default="" form="Attribute"/>
	</objectType>
	<objectType xmlns:d2p1="http://www.sample-package.org" name="ObjectPredefinedRef" base="d2p1:ObjectRef">
		<property name="PredefinedDataName" type="xs:string" default="" form="Attribute"/>
	</objectType>
	<objectType name="ObjectRef">
		<property xmlns:d3p1="http://v8.1c.ru/8.1/data/core" name="ID" type="d3p1:UUID"/>
		<property name="Presentation" type="xs:string" default="" form="Attribute"/>
	</objectType>
	<objectType xmlns:d2p1="http://www.sample-package.org" name="StageOfLimitsForEmployees" base="d2p1:Object">
		<property name="Employee" type="d2p1:ObjectRef"/>
		<property name="CashFlowItem" type="d2p1:ObjectPredefinedRef"/>
		<property name="DescriptionKey" type="xs:string" default="" form="Attribute"/>
		<property name="StartDate" type="xs:dateTime" default="0001-01-01T00:00:00" form="Element"/>
		<property name="EndDate" type="xs:dateTime" default="0001-01-01T00:00:00" form="Element"/>
	</objectType>
	<objectType xmlns:d2p1="http://www.sample-package.org" name="ДО_Документ" base="d2p1:Object">
		<property name="Организация" type="d2p1:ObjectRef"/>
		<property name="Сотрудник" type="d2p1:ObjectRef"/>
		<property name="СтатьяДвиженияДенежныхСредств" type="d2p1:ObjectPredefinedRef"/>
		<property name="Этап" type="d2p1:ObjectRef" nillable="true"/>
		<property name="Сумма" type="xs:decimal" nillable="true"/>
		<property name="Дата" type="xs:dateTime"/>
	</objectType>
</package>